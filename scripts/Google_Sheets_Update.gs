    ['EU AI Act','Regulatory reference','Legal applicability remains qualified human decision.','https://digital-strategy.ec.europa.eu/en/policies/regulatory-framework-ai','Research'],
    ['MCP Specification','Protocol reference','Read-only MCP server proposed; not implemented.','https://modelcontextprotocol.io/specification/2026-07-28','Planned'],
    ['GitHub Actions','CI','Cross-platform CI YAML included; external hosted CI not executed.','https://docs.github.com/actions','In Progress'],
    ['MLflow','Model registry','Metadata-only model registry adapter.','https://mlflow.org/docs/latest/index.html','Planned'],
    ['DataHub','Data catalog','Metadata-only dataset owner and lineage adapter.','https://datahubproject.io/','Planned'],
    ['OpenMetadata','Data catalog','Metadata-only dataset and control metadata.','https://open-metadata.org/','Planned'],
    ['SQLite','Storage','Future local DB migration path.','https://sqlite.org/','Planned'],
    ['PostgreSQL','Server storage','Future multi-user storage with RBAC and tenant isolation.','https://www.postgresql.org/','Planned']
  ];
  toolRows.forEach(t => upsert_(tools,3,t[0],[conceptId,conceptName,t[0],t[1],t[2],t[3],t[4],'Optional integration; review permissions and data scope before adoption.']));

  const milestones = [
    ['M0','Verified local starter','Registry, CLI, six-factor risk indicator, manifest scanner, evidence hashes, audit chain, reports, read-only API, 20 agents, 26 skills, 8 workflows, 10 rules.','80 tests pass; proof folder with TAP log, fuzz results and sealed audit report; CI matrix.','Done'],
    ['M1','Repository evidence depth','Versioned AI system manifests, lockfiles/SBOM, precise source pointers and model/tool/data change diff.','Fixture-based parsing and tamper/secret negative tests.','Planned'],
    ['M2','Policy and control lifecycle','Versioned policy packs, control/evidence status, freshness, exceptions and expiry.','Owner-attested controls and evidence review states.','Planned'],
    ['M3','Governance dashboard','Accessible responsive portfolio UI, system detail, review queue and evidence graph.','Keyboard/mobile/accessibility tests and grounded data.','Planned'],
    ['M4','Enterprise self-hosted server','DB, SSO, RBAC, tenant isolation, encryption, signed audit and backups.','Threat model, penetration testing and disaster recovery tests.','Planned'],
    ['M5','IDE/server ecosystem','Read-only MCP, CI, model registry, data catalog and host-version compatibility.','Per-integration scope tests and actual host validation.','Planned']
  ];
  milestones.forEach((m,i) => { const r=upsertComposite_(roadmap,[1,3],[conceptId,i+1],[conceptId,conceptName,i+1,m[0],m[1]+' — '+m[2],m[3],m[4],'Vatsal Shah','', 'Human review required for legal/framework interpretations.']); if(m[4]==='Done') roadmap.getRange(r,1,1,10).setBackground(GREEN); });

  SpreadsheetApp.flush();
  Logger.log('GovernSutra patch applied. Concepts row=' + conceptRow + '; development brief row=' + briefRow + '; prompt row=' + promptRow + '.');
}

function findRowByValue_(sheet, col, value) {
  const last = sheet.getLastRow();
  if (last < 2) throw new Error('No data rows in ' + sheet.getName());
  const vals = sheet.getRange(2,col,last-1,1).getValues();
  for (let i=0;i<vals.length;i++) if (String(vals[i][0]) === String(value)) return i+2;
  throw new Error('Could not find ' + value + ' in ' + sheet.getName());
}
function upsert_(sheet, keyCol, keyValue, rowValues) {
  const last=sheet.getLastRow(); let row=0;
  if(last>=2){const vals=sheet.getRange(2,keyCol,last-1,1).getValues();for(let i=0;i<vals.length;i++)if(String(vals[i][0])===String(keyValue)){row=i+2;break;}}
  if(!row) row=last+1;
  sheet.getRange(row,1,1,rowValues.length).setValues([rowValues]);
  return row;
}
function upsertComposite_(sheet, cols, keys, rowValues) {
  const last=sheet.getLastRow(); let row=0;
  if(last>=2){const vals=sheet.getRange(2,1,last-1,Math.max.apply(null,cols)).getValues();for(let i=0;i<vals.length;i++){let ok=true;for(let j=0;j<cols.length;j++)if(String(vals[i][cols[j]-1])!==String(keys[j]))ok=false;if(ok){row=i+2;break;}}}
  if(!row)row=last+1;
  sheet.getRange(row,1,1,rowValues.length).setValues([rowValues]);
  return row;
}
