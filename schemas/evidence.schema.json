{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Reference",
  "type": "object",
  "required": [
    "id",
    "systemId",
    "kind",
    "relativePath",
    "sha256",
    "recordedAt",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "systemId": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "relativePath": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "string"
    },
    "retention": {
      "type": "string"
    }
  }
}
