  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "doctor": "node packages/cli/index.mjs doctor",
    "demo": "node scripts/demo.mjs",
    "scan": "node packages/cli/index.mjs scan",
    "start": "node packages/cli/index.mjs serve",
    "audit": "node packages/cli/index.mjs audit --out examples/audit --force",
    "proof": "node scripts/proof.mjs",
    "docs:build": "node documents/build.mjs",
    "docs:check": "node scripts/check-links.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "bin": {
    "governsutra": "packages/cli/index.mjs",
    "governsutra-ai": "packages/cli/index.mjs"
  },
  "homepage": "https://shahvatsalofficial.github.io/governsutra-ai/",
